{
  "name": "isnad-vscode",
  "displayName": "ISNAD Security Scanner",
  "description": "Inline security warnings for AI agent skills and code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Security",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "isnad-vscode.scanCurrentFile",
        "title": "ISNAD: Scan current file for security issues"
      }
    ],
    "configuration": {
      "title": "ISNAD Scanner",
      "properties": {
        "isnad-scanner.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Scan files automatically when opened"
        },
        "isnad-scanner.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan files automatically when saved"
        },
        "isnad-scanner.sensitivity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "default": "medium",
          "description": "Minimum severity level to show warnings"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "eslint": "^8.41.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@isnad/scanner": "^0.1.0"
  }
}
